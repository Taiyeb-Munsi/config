* {
    background: #0d0f1a;
    background-alt: #161928;
    foreground: #c4bfe8;
    accent: #b8d4e8;
    selected-bg: #1e2138;
    border-col: #252840;
    placeholder-col: #6b6890;
    font: "JetBrainsMono Nerd Font 11";
}

configuration {
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: " ";
}

window {
    width: 600px;
    border: 1px;
    border-radius: 14px;
    background-color: @background;
    border-color: @border-col;
}

mainbox {
    padding: 20px;
    spacing: 12px;
    children: ["inputbar", "listview"];
}

inputbar {
    padding: 10px 14px;
    spacing: 10px;
    background-color: @background-alt;
    border-radius: 10px;
    border: 1px;
    border-color: @border-col;
    children: ["prompt", "entry"];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search...";
    placeholder-color: @placeholder-col;
    text-color: @foreground;
}

listview {
    lines: 8;
    spacing: 4px;
    cycle: true;
    scrollbar: false;
    border: 0px;
}

element {
    padding: 8px 12px;
    spacing: 10px;
    border-radius: 8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected-bg;
    text-color: @accent;
}

element-icon {
    size: 20px;
}

element-text {
    vertical-align: 0.5;
}
